  <input class="w-full h-11 pl-3.5 pr-10 rounded-xl bg-surface-canvas font-body-md text-body-md text-text-primary placeholder:text-text-muted transition-colors border border-border-default/60 cursor-not-allowed opacity-90 font-mono text-sm" id="profile-url-input" placeholder="Connect LinkedIn to load your profile" type="text" readonly disabled/>
  <span class="material-symbols-outlined text-[18px] text-text-muted absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" title="Read-only: populated from authenticated LinkedIn session">lock</span>
</div>
<button class="h-11 px-6 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md transition-all flex items-center justify-center gap-2 shadow-sm shrink-0 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-primary-container" id="extract-profile-btn" type="button" disabled>
<span class="material-symbols-outlined text-[18px]">person_search</span>
<span id="extract-profile-btn-text">Extract Profile</span>
</button>
</div>
</div>

<!-- Extraction Type Selection Section -->
<div class="flex flex-col gap-space-xs pt-3 border-t border-border-default/50">
  <div class="flex items-center justify-between">
    <label class="font-label-md text-label-md text-text-primary flex items-center gap-1.5">
      <span class="material-symbols-outlined text-[18px] text-primary-container">tune</span>
      <span>Extraction Type</span>
    </label>
    <span class="font-label-sm text-label-sm text-text-muted">Choose profile scope</span>
  </div>
  
  <div class="flex items-center gap-6 pt-1">
    <label class="flex items-center gap-2 cursor-pointer font-label-md text-label-md text-text-primary select-none">
      <input type="radio" name="extraction-type" value="complete" id="ext-type-complete" checked class="w-4 h-4 text-primary-container accent-primary-container focus:ring-primary-container cursor-pointer"/>
      <span>Complete Extraction</span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer font-label-md text-label-md text-text-primary select-none">
      <input type="radio" name="extraction-type" value="selected" id="ext-type-selected" class="w-4 h-4 text-primary-container accent-primary-container focus:ring-primary-container cursor-pointer"/>
      <span>Selected Extraction</span>
    </label>
  </div>

  <!-- Selected Extraction Checkboxes Container -->
  <div id="selected-sections-container" class="hidden flex-col gap-2 pt-3">
    <span class="font-label-sm text-label-sm text-text-secondary font-medium">Select sections to extract and optimize:</span>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-1">
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="name" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Name</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="headline" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Headline</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="about" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>About</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="experience" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Experience</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="education" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Education</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="skills" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Skills</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="certifications" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Certifications</span>
      </label>
      <label class="flex items-center gap-2 p-2 px-3 rounded-lg bg-surface-canvas border border-border-default/60 hover:bg-surface-subtle transition-colors cursor-pointer select-none font-body-sm text-body-sm text-text-primary">
        <input type="checkbox" name="selected-section" value="projects" class="w-4 h-4 accent-primary-container rounded cursor-pointer section-checkbox" checked />
        <span>Projects</span>
      </label>
    </div>
  </div>
</div>

