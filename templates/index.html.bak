<!-- Email Composer -->
<div class="bg-surface-card rounded-xl shadow-sm overflow-hidden flex flex-col border border-border-default/60">
  <div class="flex items-center justify-between px-space-md pt-space-md pb-2 border-b border-border-default/50">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-[20px] text-primary-container">mail</span>
      <h2 class="font-headline-sm text-headline-sm text-text-primary">New Email</h2>
    </div>
  </div>
  <div class="flex flex-col">
    <div class="flex items-center border-b border-border-default/50 px-space-md py-3 gap-4">
      <span class="font-label-md text-text-secondary w-12 shrink-0">From</span>
      <span class="font-body-md text-text-primary">Not configured</span>
    </div>
    <div class="flex items-center border-b border-border-default/50 px-space-md py-3 gap-4">
      <span class="font-label-md text-text-secondary w-12 shrink-0">To</span>
      <span class="font-body-md text-text-primary" id="composer-to-text">Select leads from Email Contacts below</span>
    </div>
    <div class="flex items-center border-b border-border-default/50 px-space-md py-2.5 gap-4">
      <span class="font-label-md text-text-secondary w-12 shrink-0">Subject</span>
      <input type="text" id="composer-subject" class="flex-1 bg-transparent border-none focus:outline-none focus:ring-0 font-body-md text-text-primary placeholder:text-text-muted" placeholder="Email subject..." value="Quick idea for {{company_name}}">
    </div>
    
    <!-- Banner for Template Mode (N recipients) -->
    <div id="composer-template-banner" class="hidden bg-surface-canvas/50 border-b border-border-default/50 px-space-md py-2 text-text-secondary text-[13px]">
      <span class="font-semibold text-primary">Template mode</span> &mdash; <span id="composer-template-banner-count">0 recipients selected</span>. Personalized values will be applied separately for each recipient.
    </div>

    <!-- Toolbar -->
    <div id="composer-toolbar" class="flex items-center gap-1.5 px-space-md py-2 bg-surface-canvas border-b border-border-default/50 flex-wrap">
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('bold', false, null)" title="Bold">
        <span class="material-symbols-outlined text-[18px]">format_bold</span>
      </button>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('italic', false, null)" title="Italic">
        <span class="material-symbols-outlined text-[18px]">format_italic</span>
      </button>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('underline', false, null)" title="Underline">
        <span class="material-symbols-outlined text-[18px]">format_underlined</span>
      </button>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('strikeThrough', false, null)" title="Strikethrough">
        <span class="material-symbols-outlined text-[18px]">format_strikethrough</span>
      </button>
      <div class="w-px h-5 bg-border-default mx-1"></div>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('insertUnorderedList', false, null)" title="Bullet List">
        <span class="material-symbols-outlined text-[18px]">format_list_bulleted</span>
      </button>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('insertOrderedList', false, null)" title="Numbered List">
        <span class="material-symbols-outlined text-[18px]">format_list_numbered</span>
      </button>
      <div class="w-px h-5 bg-border-default mx-1"></div>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('justifyLeft', false, null)" title="Align Left">
        <span class="material-symbols-outlined text-[18px]">format_align_left</span>
      </button>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="document.execCommand('justifyCenter', false, null)" title="Align Center">
        <span class="material-symbols-outlined text-[18px]">format_align_center</span>
      </button>
      <div class="w-px h-5 bg-border-default mx-1"></div>
      <button class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors" type="button" onclick="const url=prompt('Enter link URL:'); if(url) document.execCommand('createLink', false, url)" title="Insert Link">
        <span class="material-symbols-outlined text-[18px]">link</span>
      </button>
      <label class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors cursor-pointer" title="Insert Image">
        <span class="material-symbols-outlined text-[18px]">image</span>
        <input type="file" id="composer-image-input" accept="image/*" class="hidden">
      </label>
      <label class="p-1.5 rounded hover:bg-surface-subtle text-text-secondary transition-colors cursor-pointer" title="Add Attachment">
        <span class="material-symbols-outlined text-[18px]">attach_file</span>
        <input type="file" id="composer-attachment-input" class="hidden">
      </label>
    </div>
    
    <!-- Rich Text Body -->
    <div id="composer-body" class="p-space-md min-h-[250px] font-body-md text-text-primary focus:outline-none overflow-y-auto" contenteditable="true">
      <p>Hi <span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="first_name" contenteditable="false">[First Name]</span>,</p>
      <br>
      <p>Noticed <span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="company_name" contenteditable="false">[Company Name]</span> has been scaling <span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="business_need" contenteditable="false">[Business Need]</span> lately &mdash; congrats on the growth.</p>
      <br>
      <p>Usually at that stage, teams start missing leads simply because there aren't enough hours to follow up with everyone fast enough, and speed-to-lead can make a major difference in conversions.</p>
      <br>
      <p>We build AI agents that handle this automatically &mdash; responding to inbound leads in seconds, qualifying them, and booking calls straight into your calendar, 24/7.</p>
      <br>
      <p>One client added <span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="result_metric" contenteditable="false">[Result Metric]</span> more booked calls in their first month without hiring anyone new.</p>
      <br>
      <p>Worth a quick look at how this could work for <span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="company_name" contenteditable="false">[Company Name]</span>?</p>
      <br>
      <p><span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="sender_name" contenteditable="false">[Your Name]</span></p>
      <p><span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="sender_role" contenteditable="false">[Your Role]</span></p>
      <p><span class="email-placeholder bg-surface-subtle border border-border-default px-1.5 py-0.5 rounded text-text-secondary font-mono text-[12px] cursor-default" data-placeholder="sender_link" contenteditable="false">[Your Link]</span></p>
    </div>

    <!-- Preview Body (Read-only) -->
    <div id="composer-preview" class="hidden flex-col">
      <div class="flex items-center justify-between px-space-md py-2 bg-surface-canvas border-b border-border-default/50">
        <span class="text-[13px] text-text-secondary">Previewing personalized email for <strong id="composer-preview-lead-name" class="text-text-primary"></strong></span>
        <button type="button" id="btn-edit-template" class="text-[12px] font-semibold text-primary hover:text-primary-container transition-colors border border-primary/30 rounded px-2 py-1 bg-surface-card shadow-sm">
          Edit Template
        </button>
      </div>
      <div id="composer-preview-body" class="p-space-md min-h-[250px] font-body-md text-text-primary overflow-y-auto prose prose-sm max-w-none bg-surface-canvas/30"></div>
    </div>
    
    <!-- Attachment display -->
    <div id="composer-attachments-container" class="px-space-md pb-2 flex gap-2 flex-wrap empty:hidden"></div>

    <!-- Footer -->
    <div class="flex items-center justify-between px-space-md py-3 border-t border-border-default/50 bg-surface-canvas">
      <div class="text-[11px] font-mono text-text-muted">
        Variables: <span class="bg-surface-card px-1 py-0.5 rounded border border-border-default">{{first_name}}</span> 
        <span class="bg-surface-card px-1 py-0.5 rounded border border-border-default">{{company_name}}</span> 
        <span class="bg-surface-card px-1 py-0.5 rounded border border-border-default">{{business_need}}</span>
        <span class="bg-surface-card px-1 py-0.5 rounded border border-border-default">{{role}}</span>
      </div>
      <button id="btn-simulate-send" type="button" class="px-6 py-2 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-all flex items-center gap-2 shadow-sm">
        <span class="material-symbols-outlined text-[18px]">send</span>
        <span>Send Email</span>
      </button>
    </div>
  </div>
</div>

