</div>

<!-- ================= ONBOARDING MODAL 1: 3 QUESTIONS ================= -->
<div id="modal-onboarding-gtm" class="fixed inset-0 bg-on-surface/40 backdrop-blur-sm z-[100] flex items-center justify-center p-space-md hidden">
  <div class="bg-surface-card rounded-2xl shadow-xl border border-border-default/80 max-w-xl w-full p-space-xl flex flex-col gap-space-lg animate-in fade-in zoom-in duration-200">
    <div class="flex items-center gap-3 border-b border-border-default/60 pb-4">
      <div class="w-10 h-10 rounded-xl bg-status-score-high-bg text-primary-container flex items-center justify-center font-bold">
        <span class="material-symbols-outlined text-[22px]">auto_awesome</span>
      </div>
      <div class="flex flex-col">
        <h3 class="font-headline-sm text-headline-sm text-text-primary">Welcome to LinkedIn Growth Engine</h3>
        <p class="font-body-sm text-body-sm text-text-secondary">Please tell us about your offer and ICP to personalize your workspace.</p>
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <div class="flex flex-col gap-1.5">
        <label for="onboarding-offer-input" class="font-label-md text-label-md text-text-primary font-semibold flex items-center gap-1.5">
          <span>1. What are you offering?</span>
        </label>
        <textarea id="onboarding-offer-input" rows="2" class="p-3 rounded-xl bg-surface-canvas border border-border-default/80 font-body-md text-body-md text-text-primary focus:outline-none focus:ring-2 focus:ring-primary-container" placeholder="e.g. AI-powered B2B lead generation & outreach automation platform for sales teams..."></textarea>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="onboarding-icp-input" class="font-label-md text-label-md text-text-primary font-semibold flex items-center gap-1.5">
          <span>2. Who is your ideal customer (ICP)?</span>
        </label>
        <textarea id="onboarding-icp-input" rows="2" class="p-3 rounded-xl bg-surface-canvas border border-border-default/80 font-body-md text-body-md text-text-primary focus:outline-none focus:ring-2 focus:ring-primary-container" placeholder="e.g. Founders, VPs of Sales, Growth Leads at B2B SaaS companies (10-200 employees)..."></textarea>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="onboarding-context-input" class="font-label-md text-label-md text-text-primary font-semibold flex items-center gap-1.5">
          <span>3. Any additional context?</span>
        </label>
        <textarea id="onboarding-context-input" rows="2" class="p-3 rounded-xl bg-surface-canvas border border-border-default/80 font-body-md text-body-md text-text-primary focus:outline-none focus:ring-2 focus:ring-primary-container" placeholder="e.g. Focus on US/EU markets, average contract value $10k-$50k/year..."></textarea>
      </div>
    </div>

    <div class="flex justify-end pt-2">
      <button id="onboarding-gtm-save-btn" type="button" class="h-11 px-6 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-all flex items-center gap-2 shadow-sm active:scale-[0.98]">
        <span>Save & Continue</span>
        <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </button>
    </div>
  </div>
</div>

<!-- ================= ONBOARDING MODAL 2: PROFILE OPTIMIZATION CHOICE ================= -->
<div id="modal-onboarding-profile-opt" class="fixed inset-0 bg-on-surface/40 backdrop-blur-sm z-[100] flex items-center justify-center p-space-md hidden">
  <div class="bg-surface-card rounded-2xl shadow-xl border border-border-default/80 max-w-md w-full p-space-xl flex flex-col gap-space-lg text-center items-center animate-in fade-in zoom-in duration-200">
    <div class="w-14 h-14 rounded-2xl bg-status-score-high-bg text-primary-container flex items-center justify-center font-bold">
      <span class="material-symbols-outlined text-[28px]">auto_awesome</span>
    </div>
    <div class="flex flex-col gap-2">
      <h3 class="font-headline-sm text-xl text-text-primary font-semibold">Optimize Your Profile?</h3>
      <p class="font-body-sm text-body-sm text-text-secondary">Would you like to generate AI profile optimization suggestions targeted to your saved offer and target ICP?</p>
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full pt-2">
      <button id="onboarding-opt-yes-btn" type="button" class="w-full h-11 px-5 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-all flex items-center justify-center gap-2 shadow-sm active:scale-[0.98]">
        <span class="material-symbols-outlined text-[18px]">check_circle</span>
        <span>Yes, Optimize Profile</span>
      </button>
      <button id="onboarding-opt-skip-btn" type="button" class="w-full h-11 px-5 rounded-xl bg-surface-canvas hover:bg-surface-subtle text-text-secondary font-label-md text-label-md transition-all border border-border-default">
        <span>Skip for now</span>
      </button>
    </div>
  </div>
</div>

<!-- ================= ONBOARDING MODAL 3: GTM EXPLORATION CHOICE ================= -->
<div id="modal-onboarding-gtm-explore" class="fixed inset-0 bg-on-surface/40 backdrop-blur-sm z-[100] flex items-center justify-center p-space-md hidden">
  <div class="bg-surface-card rounded-2xl shadow-xl border border-border-default/80 max-w-md w-full p-space-xl flex flex-col gap-space-lg text-center items-center animate-in fade-in zoom-in duration-200">
    <div class="w-14 h-14 rounded-2xl bg-status-success-bg text-status-success-text flex items-center justify-center font-bold">
      <span class="material-symbols-outlined text-[28px]">rocket_launch</span>
    </div>
    <div class="flex flex-col gap-2">
      <h3 class="font-headline-sm text-xl text-text-primary font-semibold">You're All Set!</h3>
      <p class="font-body-sm text-body-sm text-text-secondary">Would you like to explore potential GTM opportunities for your target ICP right now?</p>
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full pt-2">
      <button id="onboarding-gtm-explore-btn" type="button" class="w-full h-11 px-5 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-all flex items-center justify-center gap-2 shadow-sm active:scale-[0.98]">
        <span class="material-symbols-outlined text-[18px]">explore</span>
        <span>Explore GTM</span>
      </button>
      <button id="onboarding-dashboard-btn" type="button" class="w-full h-11 px-5 rounded-xl bg-surface-canvas hover:bg-surface-subtle text-text-secondary font-label-md text-label-md transition-all border border-border-default">
        <span>Go to Dashboard</span>
      </button>
    </div>
  </div>
</div>

</div>
</div>
</main>
</div>

<!-- App Scripts -->
    <script src="{{ url_for('static', filename='js/auth.js') }}"></script>
    <script src="{{ url_for('static', filename='js/app.js') }}"></script>
    <script src="{{ url_for('static', filename='js/onboarding.js') }}"></script>
    <script src="{{ url_for('static', filename='js/profile-optimization.js') }}"></script>
    <script src="{{ url_for('static', filename='js/leads.js') }}"></script>
    <script src="{{ url_for('static', filename='js/email-outreach.js') }}"></script>
    <script src="{{ url_for('static', filename='js/gtm.js') }}"></script>

</body>
</html>