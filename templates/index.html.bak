<div class="relative w-full">
<textarea class="w-full min-h-[140px] p-3.5 rounded-xl bg-surface-canvas font-body-md text-body-md text-text-primary placeholder:text-text-muted transition-colors focus:bg-surface-card focus:outline-none focus:ring-2 focus:ring-primary-container resize-y" id="linkedin-comments" placeholder="Paste messy/raw LinkedIn comments here... e.g. Amogh Misra • 1st Co-Founder & CEO at ScaleUp AI... Interested in testing..."></textarea>
</div>
<div class="flex justify-end pt-1">
