<div class="pt-4 flex flex-col w-full max-w-md mx-auto gap-4" id="auth-forms-container">
    <div id="login-form-wrapper" class="flex flex-col gap-4">
        <h3 class="font-headline-sm text-text-primary text-center">Log In to Fameweb</h3>
        <input type="text" id="login-identifier" placeholder="Email or Phone" class="h-10 px-3 rounded-lg border border-border-default focus:border-border-focus outline-none" />
        <input type="password" id="login-password" placeholder="Password" class="h-10 px-3 rounded-lg border border-border-default focus:border-border-focus outline-none" />
        <button id="auth-login-btn" type="button" class="w-full h-10 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-headline-sm transition-all shadow-md">Log In</button>
        <div id="login-error" class="text-error text-center hidden"></div>
        <button type="button" id="show-signup-btn" class="text-primary-container text-sm hover:underline text-center">Don't have an account? Sign up</button>
    </div>
    
    <div id="signup-form-wrapper" class="flex flex-col gap-4 hidden">
        <h3 class="font-headline-sm text-text-primary text-center">Create Fameweb Account</h3>
        <input type="text" id="signup-name" placeholder="Full Name" class="h-10 px-3 rounded-lg border border-border-default focus:border-border-focus outline-none" />
        <input type="email" id="signup-email" placeholder="Email Address" class="h-10 px-3 rounded-lg border border-border-default focus:border-border-focus outline-none" />
        <input type="tel" id="signup-phone" placeholder="Phone Number (e.g. +1234567890)" class="h-10 px-3 rounded-lg border border-border-default focus:border-border-focus outline-none" />
        <input type="password" id="signup-password" placeholder="Password (min 8 chars)" class="h-10 px-3 rounded-lg border border-border-default focus:border-border-focus outline-none" />
        <button id="auth-signup-btn" type="button" class="w-full h-10 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-headline-sm transition-all shadow-md">Sign Up</button>
        <div id="signup-error" class="text-error text-center hidden"></div>
        <button type="button" id="show-login-btn" class="text-primary-container text-sm hover:underline text-center">Already have an account? Log in</button>
    </div>
</div>

<div class="pt-6 border-t border-border-default/60 w-full grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
